# Local wrangler / docs only — copy to .dev.vars for `wrangler dev`
# Never commit real values.

# Optional paid Solana RPC (otherwise public mainnet-beta)
# HELIUS_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# MCP admin key (Authorization: Bearer or X-JOE-Token — never ?key=)
# MCP_API_KEY=

# Optional Grok proxy at edge (prefer keeping keys on Jetson AARON)
# XAI_API_KEY=
