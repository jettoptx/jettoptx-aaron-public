# Local wrangler / docs only — copy to .dev.vars for `wrangler dev`
# Never commit real values.

# Optional paid Solana RPC (otherwise public mainnet-beta)
# HELIUS_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# MCP admin key (Authorization: Bearer or X-JOE-Token — never ?key=)
# MCP_API_KEY=

# SHIELD4 X OAuth allowlist (JSON object). Empty / unset = fail-closed for X OAuth
# (static MCP_API_KEY + SpacetimeDB keys still work). Do not commit real wallets/emails.
# SHIELD4_ALLOWLIST_JSON={"example_user":{"twinId":"example_user","wallet":"YOUR_SOLANA_WALLET","email":"you@example.com","founderBypass":false}}

# Optional Cloudflare Access service token for SpacetimeDB (both required or omitted)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optional Grok proxy at edge (prefer keeping keys on Jetson AARON)
# XAI_API_KEY=
